<div>
    <label for="fromDate">Event start date (from)</label>
    <input id="fromDate" name="fromDate" type="date" min="1000-01-01" max="9999-12-31" value="<%= Web.html(fromDate) %>">
</div>
<div>
    <label for="toDate">Event start date (to)</label>
    <input id="toDate" name="toDate" type="date" min="1000-01-01" max="9999-12-31" value="<%= Web.html(toDate) %>">
</div>
